# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM provider abstraction — 'openrouter' | 'anthropic' | 'deepseek'
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Fast, non-reasoning model used only for the query-rewrite step (lib/rag/rewriteQuery.ts).
# Keep this separate from OPENROUTER_MODEL, which may be a slower "reasoning" model.
OPENROUTER_REWRITE_MODEL=poolside/laguna-m.1:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Fast Anthropic model for the query-rewrite step; leave unset to default to a Haiku-class model.
ANTHROPIC_REWRITE_MODEL=claude-haiku-4-5
# DeepSeek API key from platform.deepseek.com directly (not via OpenRouter).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# deepseek-v4-flash's "thinking" mode is slow chain-of-thought, so the
# non-thinking default is used for the rewrite step too. deepseek-chat /
# deepseek-reasoner (old model ids) are deprecated 2026-07-24.
DEEPSEEK_REWRITE_MODEL=deepseek-v4-flash

# İstəyə bağlı: OpenRouter-in pulsuz gündəlik limitinə düşəndə avtomatik fallback
# (yalnız LLM_PROVIDER=openrouter üçün — LLM_PROVIDER=anthropic-də təsiri yoxdur).
# Google-un öz Gemini API-si istifadə olunur (OpenRouter-dəki Gemini yox —
# o, eyni OpenRouter kvotasını paylaşır və müstəqil tutum vermir).
#
# DİQQƏT: GOOGLE_GENERATIVE_AI_API_KEY həm də EMBEDDING üçün istifadə olunur
# (lib/embeddings/gemini.ts, gemini-embedding-001, 1536 ölçü) — yalnız chat
# fallback/vision üçün deyil. Embedding provayderi LLM_PROVIDER-dən TAMAMİLƏ
# ayrı bir oxdur: hansı modelin işlədiyini app_settings-dəki
# `active_embedding_model` açarı ('local' | 'gemini', default 'local')
# müəyyən edir və admin paneldən dəyişdirilir — env dəyişəni ilə yox.
# Bu açar yalnız `chunks.embedding_gemini` əhatəsi 100% olduqda 'gemini'-yə
# keçirilə bilər (scripts/backfill-gemini-embeddings.mjs).
GOOGLE_GENERATIVE_AI_API_KEY=
# İkinci Gemini açarı (pulsuz tier). LLM_ROUTING=gemini-first-də zəncir belə işləyir:
# gemini açar1 → gemini açar2 → LLM_PROVIDER modeli (məs. deepseek). Bu açar verilməsə,
# zəncir sadəcə [gemini1 → LLM_PROVIDER] olur.
GOOGLE_GENERATIVE_AI_API_KEY_2=
# Cavab modeli. CHAT və REWRITE FƏRQLİ model olmalıdır ki, pulsuz kvotalar toqquşmasın
# (hər modelin öz RPD limiti var). Hər İKİ açarda işləyən modellər seçilməlidir: yeni
# Google hesablarında gemini-2.5-* mövcud deyil (404 — "no longer available to new
# users"), ona görə 3.x flash-lite tövsiyə olunur. Pulsuz tutum üçün flash-lite (kvota
# ~4×: ~1000 RPD); yüksək keyfiyyət istəsəniz gemini-3.5-flash (hər iki açarda işləyir).
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_REWRITE_MODEL=gemini-3.5-flash-lite

# Groq — gündəlik sıfırlanan pulsuz limit (1K RPD / hər model, 30 RPM).
# İki açar = iki ayrı hesab → pulsuz tutum 2x. Açar boşdursa slot atlanır.
# Açar: https://console.groq.com (pulsuz, kart yoxdur).
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.6-27b
# Rewrite üçün AYRI model: hər Groq modelinin öz 1K RPD kvotası var, chat və rewrite
# trafikini ayırmaq pulsuz tutumu ikiqat edir (geri qaytarmaq üçün eyni modeli yazın).
# Rewrite slots (llama) reasoning parametri qəbul etmir — ona görə GROQ_REASONING_OFF
# yalnız chat slots-a (qwen) verilir, rewrite-a yox.
GROQ_REWRITE_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (build.nvidia.com) — ~40 RPM, GÜNDƏLİK LİMİT YOXDUR (bitmir, yalnız
# yavaşlayır) — amma digərlərindən yavaşdır (~35 tok/s), ona görə zəncirin SONUNDA
# (paid primary-dən sonra) insurance tier kimi işləyir: deepseek də bitəndə belə cavab verir.
# Açar: https://build.nvidia.com → Settings → API Keys → Get API Key (nvapi- ilə başlayır,
# pulsuz, kart yoxdur).
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REWRITE_MODEL=meta/llama-3.3-70b-instruct

# Mistral — pulsuz Experiment plan, ~1 milyard token/ay, kart yoxdur.
# Açar: https://console.mistral.ai → sign up → API Keys (pulsuz).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_REWRITE_MODEL=mistral-small-latest

# Gemini-first routing. Yalnız bu dəyər verildikdə yuxarıdakı zəncir işləyir; boş/başqa
# dəyərdə köhnə davranış qalır (primary = LLM_PROVIDER; fallback yalnız openrouter üçün).
# Tam zəncir: groq açar1 → groq açar2 → mistral → gemini açar1 → gemini açar2 →
# LLM_PROVIDER (deepseek/anthropic/openrouter) → nvidia (son instansiya, gündəlik
# limiti yoxdur). Bütün pulsuz limitlər qurtaranda primary, primary də bitəndə nvidia cavab verir.
LLM_ROUTING=gemini-first

# Rate limiting — regular users only, admins are exempt (app/api/chat/route.ts).
# Fixed-window counter (lib/chat/rateLimit.ts, check_chat_rate_limit RPC).
# Ultimate fallback default — the effective global default can also be
# configured at runtime via the app_settings table (see
# app/api/admin/settings/rate-limit/route.ts), which takes precedence over
# this env var when set.
CHAT_RATE_LIMIT_MAX_PER_DAY=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=86400
CHAT_RATE_LIMIT_MIN_SPACING_SECONDS=4

# Feature flags
NEXT_PUBLIC_ADS_ENABLED=false

# Push notifications (Phase 3b) — generate a real keypair with
# `npx web-push generate-vapid-keys` and set the same public key value in
# both VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY (the public key is
# safe to expose client-side for pushManager.subscribe({applicationServerKey})).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Monetag (Reklam izlə → coin qazan real reklam şəbəkəsi). İki rejim,
# hər ikisi client-də oxunur (NEXT_PUBLIC_) — bunlar səhifə mənbəyində
# onsuz da görünən public dəyərlərdir, sirr deyil. Coin mükafatı hər halda
# server tərəfdəki nonce + vaxt yoxlaması ilə qorunur (lib/coins/adWatch.ts).
# Prioritet (lib/ads/rewardedAd.ts): ZONE_ID > DIRECT_LINK > simulyasiya.
#
# SDK rejimi (Rewarded Interstitial, hazırda veb üçün verilmir — gələcək
# TMA/SDK zonası üçün saxlanılıb). Tam-ekran reklam, bitəndə avto-claim.
NEXT_PUBLIC_MONETAG_ZONE_ID=
# Direct Link rejimi (HAZIRKI AKTİV YOL) — Monetag paneldən alınan tam URL,
# məs. https://omg10.com/4/XXXXXXXX. Reklam yeni tabda açılır, countdown
# modalı claim-i qoruyur (bu rejimdə "izləmə bitdi" callback-i yoxdur).
NEXT_PUBLIC_MONETAG_DIRECT_LINK=
